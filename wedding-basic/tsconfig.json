{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@eventlab/effects": ["../effects/src/index.ts"],
      "@eventlab/effects/catalog": ["../effects/src/catalog.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
